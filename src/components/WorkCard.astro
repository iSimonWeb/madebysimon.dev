---
import Badge from './Badge.astro';
import Tag from './Tag.astro';
import type { WorkItem } from '../data/work';

interface Props {
  item: WorkItem;
}

const { item } = Astro.props;
---

<article class="relative flex flex-col gap-4 rounded-card bg-card-dark p-7">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h3 class="text-[26px] leading-tight font-semibold">
      {item.href ? (
        <a
          href={item.href}
          class="text-paper no-underline after:absolute after:inset-0 after:rounded-card"
        >
          {item.name}
        </a>
      ) : (
        item.name
      )}
    </h3>
    {item.badge ? (
      <Badge size="sm">{item.badge}</Badge>
    ) : (
      <span class="font-mono text-[13px] font-semibold text-muted-on-dark">{item.kind}</span>
    )}
  </div>
  <p class="text-[17px] leading-[1.55] text-on-dark">{item.description}</p>
  <ul
    class="flex flex-wrap gap-2 font-mono text-[13px] font-semibold text-on-dark"
    aria-label="Built with"
  >
    {item.tags.map((tag) => (
      <Tag>{tag}</Tag>
    ))}
  </ul>
</article>

---
/**
 * The start-up terminal: "builds" Simon from source, then rolls up like a shop
 * shutter to show the page, which is already rendered underneath.
 * Shown once per browser session, never with reduced motion or without JS
 * (the inline script in Base decides), and any key, click, scroll or tap skips it.
 */
import MarkSmall from './MarkSmall.astro';
import { site } from '../data/site';
---

<div class="boot fixed inset-0 z-50 flex-col bg-ink text-paper" aria-hidden="true">
  <div class="container-page flex items-center gap-3 py-6">
    <MarkSmall size={40} variant="inverted" />
    <span class="font-mono text-xl font-bold tracking-[-0.02em]">{site.wordmark}</span>
  </div>
  <div class="container-page pt-[14vh]">
    <pre class="boot-log min-h-[9lh] sm:min-h-[5lh] font-mono text-[15px] leading-[1.7] font-medium whitespace-pre-wrap [overflow-wrap:anywhere] sm:text-lg lg:text-[22px]"></pre>
    <p class="mt-8 font-mono text-sm text-muted-on-dark">Press any key or tap to skip</p>
  </div>
</div>

<style>
  .boot {
    display: none;
    clip-path: inset(0 0 0 0); /* `none` can't be animated, so the wipe starts from here */
  }

  :global(html[data-boot]) .boot {
    display: flex;
    /* If the script never runs, the terminal still gets out of the way. */
    animation: boot-failsafe 0s 10s forwards;
  }

  .boot.is-leaving {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 550ms cubic-bezier(0.7, 0, 0.2, 1);
  }

  .boot.is-skipping {
    transition-duration: 200ms;
  }

  .boot :global(.row) {
    display: flex;
  }

  .boot :global(.lead) {
    flex: none;
    white-space: pre;
  }

  .boot :global(.prompt),
  .boot :global(.ok) {
    color: var(--color-accent);
  }

  .boot :global(.note) {
    color: var(--color-muted-on-dark);
  }

  .boot :global(.caret) {
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
    vertical-align: text-bottom;
    background: var(--color-accent);
    animation: caret-blink 1s steps(1) infinite;
  }

  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes boot-failsafe {
    to {
      visibility: hidden;
    }
  }
</style>

<script>
  import { BIRTH_YEAR, boot } from '../data/boot';

  const root = document.documentElement;
  const overlay = document.querySelector<HTMLElement>('.boot');
  const log = overlay?.querySelector<HTMLElement>('.boot-log');

  const TYPE_MS = 28;
  const SPINNER = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏'];
  const SPINNER_MS = 80;
  const VERB_MS = 320;
  const VERB_COUNT = 4;

  let skipped = false;
  const wait = (ms: number) =>
    new Promise<void>((resolve) => setTimeout(resolve, skipped ? 0 : ms));

  /** One log row: a fixed lead column (prompt or glyph) and text that wraps under itself. */
  function line(lead: string, leadClass: string, text = '', textClass = '') {
    const row = document.createElement('div');
    row.className = 'row';
    const leadSpan = document.createElement('span');
    leadSpan.className = `lead ${leadClass}`;
    leadSpan.textContent = lead;
    const textSpan = document.createElement('span');
    textSpan.className = textClass;
    textSpan.textContent = text;
    row.append(leadSpan, textSpan);
    log!.append(row);
    return [leadSpan, textSpan] as const;
  }

  async function type(command: string) {
    const [, text] = line(`${boot.prompt} `, 'prompt');
    const typed = document.createTextNode('');
    const caret = document.createElement('span');
    caret.className = 'caret';
    text.append(typed, caret);
    await wait(250);
    for (const char of command) {
      if (skipped) break;
      typed.data += char;
      await wait(TYPE_MS);
    }
    typed.data = command;
    await wait(200);
    caret.remove();
  }

  async function spin(verbs: string[]) {
    const [glyph, label] = line('', 'ok');
    const start = performance.now();
    while (!skipped && performance.now() - start < verbs.length * VERB_MS) {
      const elapsed = performance.now() - start;
      glyph.textContent = `  ${SPINNER[Math.floor(elapsed / SPINNER_MS) % SPINNER.length]} `;
      label.textContent = `${verbs[Math.floor(elapsed / VERB_MS)]}…`;
      await wait(SPINNER_MS);
    }
    glyph.parentElement!.remove();
  }

  function pick<T>(items: T[], count: number) {
    return [...items].sort(() => Math.random() - 0.5).slice(0, count);
  }

  function leave() {
    overlay!.classList.add('is-leaving');
    if (skipped) overlay!.classList.add('is-skipping');
    const done = () => root.removeAttribute('data-boot');
    overlay!.addEventListener('transitionend', done, { once: true });
    setTimeout(done, 800);
  }

  function skip() {
    skipped = true;
  }

  async function run() {
    const years = new Date().getFullYear() - BIRTH_YEAR;

    await type(boot.build.command);
    line('  → ', 'note', boot.build.note, 'note');
    await spin(pick(boot.verbs, VERB_COUNT));
    line('  ✓ ', 'ok', boot.build.done(years));
    await wait(300);
    await type(boot.serve.command);
    line('  ✓ ', 'ok', boot.serve.done);
    await wait(650);
    leave();
  }

  if (root.hasAttribute('data-boot') && overlay && log) {
    for (const event of ['keydown', 'pointerdown', 'wheel', 'touchstart']) {
      addEventListener(event, skip, { once: true, passive: true });
    }
    run();
  }
</script>

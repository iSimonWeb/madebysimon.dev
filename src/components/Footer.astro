---
import MarkSmall from './MarkSmall.astro';
import { site, socials } from '../data/site';

const year = new Date().getFullYear();
const links = [{ label: 'madebysimon.dev', href: site.url }, ...socials];
---

<footer class="on-dark bg-ink text-muted-on-dark">
  <div class="container-page flex flex-wrap items-center justify-between gap-4 py-8 text-[15px]">
    <div class="flex items-center gap-3">
      <MarkSmall size={32} variant="inverted" />
      <p>
        © {year} {site.name}
      </p>
    </div>
    <ul class="flex flex-wrap gap-x-5 gap-y-2 font-mono font-semibold">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-on-dark underline decoration-accent underline-offset-4 hover:decoration-2"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

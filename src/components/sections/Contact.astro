---
import { site } from '../../data/site';
---

<section
  id="contact"
  aria-labelledby="contact-title"
  class="flex flex-col gap-4 border-t-2 border-ink pt-16 pb-24"
>
  <h2 id="contact-title" class="heading-2">
    Say hello
  </h2>
  <a
    href={`mailto:${site.email}`}
    class="self-start underline text-[clamp(1.75rem,6.5vw,2.75rem)] font-bold tracking-[-0.02em] [overflow-wrap:anywhere] text-ink decoration-accent decoration-[6px] underline-offset-8 transition-[text-decoration-thickness] hover:decoration-[10px]"
  >
    {site.email}
  </a>
</section>

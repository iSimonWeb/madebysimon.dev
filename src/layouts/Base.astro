---
import '../styles/global.css';
import sansFont from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import monoFont from '@fontsource-variable/red-hat-mono/files/red-hat-mono-latin-wght-normal.woff2?url';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f4f4f1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Both families render above the fold (wordmark, eyebrow, headline). -->
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="The Made by Simon Si element tile, next to the madebysim0n wordmark and the line Small, solid software."
    />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Decides before first paint whether the start-up terminal plays (see BootTerminal). -->
    <script is:inline>
      try {
        if (
          !matchMedia('(prefers-reduced-motion: reduce)').matches &&
          !sessionStorage.getItem('booted')
        ) {
          sessionStorage.setItem('booted', '1');
          document.documentElement.setAttribute('data-boot', '');
        }
      } catch {}
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only rounded-button bg-ink px-4 py-3 font-semibold text-paper focus:not-sr-only focus:absolute focus:px-4 focus:py-3 focus:top-3 focus:left-3 focus:z-10"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>

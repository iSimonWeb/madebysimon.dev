---
import Base from '../layouts/Base.astro';
import BootTerminal from '../components/BootTerminal.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import Perfboard from '../components/Perfboard.astro';
import About from '../components/sections/About.astro';
import Apps from '../components/sections/Apps.astro';
import Contact from '../components/sections/Contact.astro';
import Hero from '../components/sections/Hero.astro';
import Lab from '../components/sections/Lab.astro';
import Work from '../components/sections/Work.astro';
---

<Base>
  <BootTerminal />
  <div id="top" class="relative isolate">
    <Perfboard />
    <Nav />
    <main id="main" tabindex="-1" class="outline-none">
      <div class="container-page">
        <Hero />
        <Apps />
      </div>
      <Work />
      <div class="container-page">
        <Lab />
        <About />
        <Contact />
      </div>
    </main>
    <Footer />
  </div>
</Base>
